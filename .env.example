# Kindle email address (found in Kindle Settings > Your Account)
KINDLE_EMAIL=your-kindle@kindle.com

# Sender email address (Gmail, Outlook, Yahoo, Zoho, etc.)
SMTP_EMAIL=your-email@gmail.com

# Email password or app password
# For Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password

# SMTP server (auto-detected from email, optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
